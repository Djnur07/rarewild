# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated character variants (scripts/character/generateVariant.ts output)
/public/assets/character/variants/

# RAREWILD artwork: 157 MB, filled locally by scripts/rareWild/sync-artwork.ts (or served from a CDN)
/public/assets/rareWild/skins/

# but keep the documented template committed
!.env.example
