# RAREWILD wallet / NFT ownership settings (all optional; copy to .env.local to use).
# These are NEXT_PUBLIC_ values: they are bundled into the browser build, so never put secrets in them.

# The RAREWILD collection (ERC-721) contract address, 0x followed by 40 hex characters.
# Leave empty until the real contract is deployed: the game then shows "Collection contract is not configured."
NEXT_PUBLIC_RAREWILD_CONTRACT_ADDRESS=

# Numeric id of the chain the contract lives on (e.g. 1 = Ethereum mainnet, 8453 = Base). When set, the game asks
# the wallet to switch networks if it is on a different chain (unless an RPC URL below is used for reads).
NEXT_PUBLIC_RAREWILD_CHAIN_ID=

# Read-only JSON-RPC endpoint for that chain (http/https). When set, ownership is read through it instead of the wallet.
# It is visible to every visitor: use a public endpoint or a key restricted to your domain, never a private key or a secret.
NEXT_PUBLIC_RAREWILD_RPC_URL=

# Optional overrides for where the game loads RAREWILD data and artwork from.
# NEXT_PUBLIC_RAREWILD_ASSET_BASE=https://cdn.example.com/rarewild/skins
# NEXT_PUBLIC_RAREWILD_DATASET_URL=/data/rarewild-metadata.json
